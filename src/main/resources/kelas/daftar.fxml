<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label styleClass="title" text="Katalog barang" />
            <TextField fx:id="cariField" onAction="#cari" promptText="Cari kode atau nama" />
            <ComboBox fx:id="filterJenisBox" />
            <FlowPane hgap="10" vgap="8">
                <Button onAction="#cari" text="Cari" />
                <Button onAction="#resetPencarian" text="Reset" />
                <Button onAction="#tambah" styleClass="button-primary" text="Tambah" />
                <Button onAction="#detail" text="Lihat Detail" />
                <Button onAction="#hapus" text="Hapus" />
                <CheckBox fx:id="totalCheck" onAction="#ubahTampilanTotal" selected="true" text="Total" />
                <CheckBox fx:id="jumlahCheck" onAction="#ubahTampilanJumlah" selected="true" text="Jumlah" />
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columns>
                <TableColumn fx:id="kodeCol" prefWidth="100" text="Kode" />
                <TableColumn fx:id="namaCol" prefWidth="230" text="Barang" />
                <TableColumn fx:id="jenisCol" prefWidth="150" text="Jenis" />
                <TableColumn fx:id="jumlahCol" prefWidth="100" text="Harga" />
                <TableColumn fx:id="totalCol" prefWidth="150" text="Jumlah" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
    </bottom>
</BorderPane>
